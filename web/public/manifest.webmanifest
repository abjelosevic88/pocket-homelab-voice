{
  "name": "Pocket Voice",
  "short_name": "Voice",
  "description": "Voice memos you record on your phone, written out on your own server and filed into notes, tasks and your calendar.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#c2255c",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Record a memo",
      "url": "/?record=1"
    },
    {
      "name": "Inbox",
      "url": "/inbox"
    },
    {
      "name": "All memos",
      "url": "/memos"
    }
  ]
}
